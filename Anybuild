
load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "pnpm run start",
    },
    node_version = "24",
    node_package_manager = "pnpm",
    node_framework = "next",
    node_server = "node",
    node_build_command = "pnpm run build",
    node_install_requires_all_files = True,
)

build = node_build(config)

node_serve(config, build, name = "windows-11-on-web")
